# React Native's Metro bundler and the CocoaPods integration both resolve
# modules by walking node_modules directly rather than through Node's resolver,
# so pnpm's default symlinked store breaks them in ways that surface as
# "Unable to resolve module" from inside a build.
#
# hoisted gives pnpm's lockfile and its shared content-addressed store — which
# is what makes the `pnpm` cache in .latem/jobs.yaml worth mounting — with a
# node_modules layout npm would have produced. This is Expo's documented
# configuration for pnpm, not a workaround we invented.
node-linker=hoisted
