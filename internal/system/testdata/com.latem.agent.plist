<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- latem service definition, revision 2 -->
<dict>
	<key>Label</key>
	<string>com.latem.agent</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/tester/.local/bin/latem</string>
		<string>agent</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>5</integer>
	<key>ExitTimeOut</key>
	<integer>1830</integer>
	<!-- Interactive, as GitHub's own runner has it: launchd.plist(5) gives a
	     Standard job, like one with no ProcessType, "light resource limits"
	     on its CPU and disk I/O, and a Background job more. A build is slower
	     under them for reasons that never appear in any log, and a test that
	     records frames in real time fails: take-one's recorder tests wrote 11
	     to 14 frames of 30 in the agent and passed over ssh on the same Mac. -->
	<key>ProcessType</key>
	<string>Interactive</string>
	<key>WorkingDirectory</key>
	<string>/Users/tester</string>
	<key>StandardOutPath</key>
	<string>/Users/tester/.latem/logs/agent.out.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/tester/.latem/logs/agent.err.log</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
</dict>
</plist>
